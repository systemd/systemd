# This file is part of systemd.
#
# Database for USB devices, matched by the interfaces they expose.
#
# The lookup key is:
#   usb-interface:v<vendor>p<product>:<interfaces>
# where <vendor> and <product> are the lowercase hexadecimal vendor and product
# IDs (ID_USB_VENDOR_ID and ID_USB_MODEL_ID), and <interfaces> is the
# colon-separated list of interface class, subclass and protocol triplets
# (ID_USB_INTERFACES).
#
# Permitted keys:
#   Specify the directory below /dev for the by-id and by-path device symlinks
#   ID_LINK_DIR=<name>
#
#   Specify if a device is a USB3 Vision device
#   ID_USB3_VISION=0|1
#
#   Specify if a device is a printer
#   ID_PRINTER=0|1
#
#   Specify if a device is a smartcard reader
#   ID_SMARTCARD_READER=0|1
#
#   Specify if a device is a PTP/MTP protocol device, e.g. a camera or a
#   portable media player
#   ID_PTP_MTP=0|1
#
#   Specify the protocol used to interact with a debug appliance, see
#   70-debug-appliance.hwdb
#   ID_DEBUG_APPLIANCE=?*
#
#   Specify the form factor of the sound card of a device
#   SOUND_FORM_FACTOR=webcam

# USB3 Vision devices exposing the device control interface
usb-interface:v*p*:ef0500:*
 ID_USB3_VISION=1
 ID_LINK_DIR=u3v

# Printers (interface class 07, subclass 01)
usb-interface:v*p*:0701??:*
 ID_PRINTER=1

# Smartcard readers (interface class 0b, CCID)
usb-interface:v*p*:0b????:*
 ID_SMARTCARD_READER=1

# PTP/MTP protocol devices, cameras, portable media players
usb-interface:v*p*:060101:*
 ID_PTP_MTP=1

# Android devices (ADB DbC, ADB, Fastboot)
# Used to interact with devices over Android Debug Bridge and Fastboot protocols, see:
# * https://developer.android.com/tools/adb
# * https://source.android.com/docs/setup/test/running
# * https://source.android.com/docs/setup/test/flash
#
# The bInterfaceClass and bInterfaceSubClass used are documented in source code here:
# * https://android.googlesource.com/platform/packages/modules/adb/+/d0db47dcdf941673f405e1095e6ffb5e565902e5/adb.h#199
# * https://android.googlesource.com/platform/system/core/+/7199051aaf0ddfa2849650933119307327d8669c/fastboot/fastboot.cpp#244
#
# Since it's using a generic vendor specific interface class, this can potentially result
# in a rare case where non-ADB/Fastboot device ends up with an ID_DEBUG_APPLIANCE="android".
usb-interface:v*p*:dc0201:*
usb-interface:v*p*:ff4201:*
usb-interface:v*p*:ff4203:*
 ID_DEBUG_APPLIANCE=android

# Devices that also support Image/Video interfaces are most likely webcams
usb-interface:v*p*:0e????:*
 SOUND_FORM_FACTOR=webcam
