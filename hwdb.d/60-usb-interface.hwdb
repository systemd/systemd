# This file is part of systemd.
#
# Database for USB devices, matched by the interfaces they expose.
#
# The lookup key is:
#   usb-interface:v<vendor>p<product>:<interfaces>
# where <vendor> and <product> are the lowercase hexadecimal vendor and product
# IDs (ID_USB_VENDOR_ID and ID_USB_MODEL_ID), and <interfaces> is the
# colon-separated list of interface class, subclass and protocol triplets
# (ID_USB_INTERFACES).
#
# Permitted keys:
#   Specify the directory below /dev for the by-id and by-path device symlinks
#   ID_LINK_DIR=<name>
#
#   Specify if a device is a USB3 Vision device
#   ID_USB3_VISION=0|1
#
#   Specify if a device is a printer
#   ID_PRINTER=0|1
#
#   Specify if a device is a smartcard reader
#   ID_SMARTCARD_READER=0|1
#
#   Specify if a device is a PTP/MTP protocol device, e.g. a camera or a
#   portable media player
#   ID_PTP_MTP=0|1

# USB3 Vision devices exposing the device control interface
usb-interface:v*p*:ef0500:*
 ID_USB3_VISION=1
 ID_LINK_DIR=u3v

# Printers (interface class 07, subclass 01)
usb-interface:v*p*:0701??:*
 ID_PRINTER=1

# Smartcard readers (interface class 0b, CCID)
usb-interface:v*p*:0b????:*
 ID_SMARTCARD_READER=1

# PTP/MTP protocol devices, cameras, portable media players
usb-interface:v*p*:060101:*
 ID_PTP_MTP=1
