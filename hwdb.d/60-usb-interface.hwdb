# This file is part of systemd.
#
# Database for USB devices, matched by the interfaces they expose.
#
# The lookup key is:
#   usb-interface:v<vendor>p<product>:<interfaces>
# where <vendor> and <product> are the lowercase hexadecimal vendor and product
# IDs (ID_VENDOR_ID and ID_MODEL_ID), and <interfaces> is the colon-separated
# list of interface class, subclass and protocol triplets (ID_USB_INTERFACES).
#
# Permitted keys:
#   Specify if a device is a USB3 Vision device
#   ID_USB3_VISION=0|1

# USB3 Vision devices exposing the device control interface
usb-interface:v*p*:ef0500:*
 ID_USB3_VISION=1
