#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-2.1-or-later

# The instrumented EFI boot loader writes its .gcda counter files to the UEFI
# loader directory on the ESP. Move them into /coverage (they use the same '#'
# encoded file names as the host coverage data) and drop them from the ESP so
# that a later boot of the same image does not report them twice.
if [ -d /boot/loader ]; then
        find /boot/loader -maxdepth 1 -name '*.gcda' -exec mv -f {} /coverage/ \;
fi

logger --journald <<EOF
MESSAGE=Tarball with coverage data from /coverage and the EFI loader directory
COVERAGE_TAR=$(tar --create --file - --directory /coverage --zstd . | base64 --wrap=0)
EOF

journalctl --flush
