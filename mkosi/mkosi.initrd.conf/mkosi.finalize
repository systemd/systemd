#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -e

# The certificate mkosi installs for userspace verification, mirrored into the VOA hierarchy so that
# systemd-keyring-setup enrolls it into the .dm-verity keyring while the initrd still can.
if [ -f "$BUILDROOT/usr/lib/verity.d/mkosi.crt" ]; then
    id=$(. "$BUILDROOT/usr/lib/os-release" && echo "$ID")
    install -D -m 0644 "$BUILDROOT/usr/lib/verity.d/mkosi.crt" "$BUILDROOT/usr/share/voa/$id/image/default/x509/mkosi-certificate.pem"
fi
