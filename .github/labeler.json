    "mountfsd": ["*mountfsd*"],
    "network": [
      "src/libsystemd-network/*",
      "src/network/*",
      "network/*",
      "test/networkd-test.py",
      "test/test-network*"
    ],
    "notify": ["src/notify/*"],
    "nspawn": ["*nspawn*"],
    "nsresource": ["*nsresource*"],
    "nss-myhostname": ["*nss-myhostname*"],
    "portable": ["src/portable/*"],
    "pstore": ["*pstore*"],
    "random-seed": ["*random-seed*"],
    "remount-fs": ["*remount-fs*"],
    "repart": ["*repart*"],
    "resolve": ["*resolve*"],
    "rfkill": ["*rfkill*"],
    "rpm": ["src/rpm/*"],
    "run": ["src/run/*", "man/systemd-run*"],
    "sd-boot/sd-stub/bootctl": [
      "src/boot/*",
      "src/bootctl/*",
      "man/bootctl*",
      "man/systemd-boot.xml"
    ],
    "sd-bus": ["*sd-bus*/*"],
    "sd-daemon": ["*sd-daemon*/*"],
    "sd-device": ["*sd-device*/*"],
    "sd-event": ["*sd-event*/*"],
    "sd-hwdb": ["*sd-hwdb*/*"],
    "sd-id128": ["*sd-id128*/*"],
    "sd-netlink": ["*sd-netlink*/*"],
    "sd-path": ["*sd-path*/*"],
    "sd-resolve": ["*sd-resolve*/*"],
    "selinux": ["*selinux*"],
    "shell completion": ["shell-completion/*"],
    "shell profile": ["profile.d/*"],
    "shutdown": ["src/shutdown/*", "units/*shutdown*"],
    "sleep": ["src/shared/*sleep*", "src/sleep/*"],
    "smack": ["*smack*"],
    "socket-proxy": ["*socket-proxy*"],
    "ssh-generator": ["*ssh-generator*"],
    "storagetm": ["*storagetm*"],
    "sulogin": ["*sulogin*"],
    "sysctl": ["*sysctl*"],
    "sysext": ["*sysext*"],
    "systemctl": ["*systemctl*"],
    "sysupdate": ["*sysupdate*"],
    "sysusers": ["*sysusers*"],
    "tests": [
      "src/shared/tests.*",
      "src/test/*",
      "src/fuzz/*",
      "test/*",
      "*test-*",
      "*test_*",
      ".github/workflows/*"
    ],
    "timedate": ["*timedate*"],
    "timesync": ["*timesync*"],
    "tmpfiles": ["*tmpfiles*"],
    "tpm2": ["*tpm2*", "*tpm-*"],
    "udev": ["src/udev/*", "src/libudev/*", "man/*udev*", "rules.d/*"],
    "uki": ["*ukify*"],
    "units": ["units/*"],
    "user-session": ["*user-session*"],
    "userdb": ["*userdb*"],
    "util-lib": ["src/fundamental/*", "src/basic/*", "src/shared/*"],
    "utmp/wtmp": ["*utmp*"],
    "varlink": ["src/varlink/*", "src/libsystemd/sd-varlink/*", "src/systemd/sd-varlink*"],
    "vconsole": ["*vconsole*"],
    "veritysetup": ["*veritysetup*"],
    "vmspawn": ["*vmspawn*"],
    "volatile": ["*volatile*"],
    "xdg-autostart": ["*xdg-autostart-generator*"]
