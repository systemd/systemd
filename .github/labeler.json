{
  "max-labels": 5,
  "too-many-labels": "tree-wide",
  "labels": {
    "analyze": ["src/analyze/*"],
    "apparmor": ["*apparmor*"],
    "ask-password": ["*ask-password*"],
    "backlight": ["*backlight*"],
    "battery-check 🪫": ["*battery*"],
    "binfmt": ["*binfmt*"],
    "bsod": ["*bsod*"],
    "btrfs": ["*btrfs*"],
    "build-system": ["meson_options.txt", "*meson.build"],
    "busctl": ["*busctl*"],
    "catalog": ["catalog/*"],
    "cgls": ["*cgls*"],
    "cgroups": [
      "src/basic/cgroup*",
      "src/cgroups-agent/*",
      "src/core/cgroup*",
      "src/shared/cgroup*"
    ],
    "cgtop": ["*cgtop*"],
    "ci": [".github/*"],
    "coccinelle": ["coccinelle/*"],
    "coredump": ["*coredump*"],
    "creds": ["src/core/*cred*", "src/creds/*", "src/shared/*cred*", "units/*cred*"],
    "cryptsetup": ["src/cryptenroll/*", "src/cryptsetup/*", "units/*crypt*"],
    "debug-generator": ["*debug-generator*"],
    "delta": ["*delta*"],
    "detect-virt": ["*virt*"],
    "dissect": ["*dissect*"],
    "documentation": ["NEWS", "README*", "docs/*", "man/*"],
    "env-generator": ["*environment*generator*"],
    "escape": ["src/escape/*"],
    "firstboot": ["*firstboot*"],
    "fsck": ["*fsck*"],
    "fstab-generator": ["*fstab-generator*"],
    "gpt-auto": ["*gpt-auto*"],
    "growfs": ["*growfs*"],
    "hibernate-resume": ["*hibernate-resume*"],
    "homed": ["src/home*", "units/*home*"],
    "hostname": ["src/hostname/*", "src/shared/*hostname*", "units/*hostname*"],
    "hwdb": ["*hwdb*"],
    "import": ["src/import/*", "src/shared/*import*", "units/*import*"],
    "integritysetup": ["*integrity*"],
    "journal": [
      "src/journal/*",
      "src/libsystemd/sd-journal/*",
      "units/systemd-journal-catalog*",
      "units/systemd-journal-flush*",
      "units/systemd-journald*"
