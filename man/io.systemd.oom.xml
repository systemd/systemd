  </refnamediv>

  <refsect1>
    <title>Description</title>

    <para><interfacename>io.systemd.oom</interfacename> is a Varlink interface implemented by
    <citerefentry><refentrytitle>systemd</refentrytitle><manvolnum>1</manvolnum></citerefentry>-related
    components. It can be introspected and called with
    <citerefentry><refentrytitle>varlinkctl</refentrytitle><manvolnum>1</manvolnum></citerefentry>.</para>


  </refsect1>

  <refsect1>
    <title>Interface Definition</title>

    <para>The following interface definition is exposed:</para>

    <programlisting varlink-interface="io.systemd.oom">
interface io.systemd.oom

type ManagedOOMMode(
	auto,
	kill
)

type ControlGroup(
	mode: ManagedOOMMode,
	path: string,
	property: string,
	limit: ?int,
	duration: ?int,
	rules: ?[]string
)

method ReportManagedOOMCGroups(
	cgroups: []ControlGroup
) -&gt; ()
</programlisting>

    <!--Autogenerated cross-references for systemd.directives, do not edit-->

    <variablelist class="varlink-interface" generated="True" extra-ref="io.systemd.oom"/>

    <variablelist class="varlink-type" generated="True" extra-ref="ManagedOOMMode"/>

    <variablelist class="varlink-method" generated="True" extra-ref="ReportManagedOOMCGroups()"/>

    <variablelist class="varlink-type" generated="True" extra-ref="ControlGroup"/>

