[Unit]
Description=Test ProtectSystem=strict

[Service]
ProtectSystem=strict
MountAPIVFS=yes
Type=oneshot
# The whole hierarchy is read-only, including /run/ (even though MountAPIVFS= would otherwise set up a
# writable tmpfs there).
ExecStart=bash -x -c '! touch /thisshouldnotwork'
ExecStart=bash -x -c '! touch /usr/thisshouldnotwork'
ExecStart=bash -x -c '! touch /etc/thisshouldnotwork'
ExecStart=bash -x -c '! touch /run/thisshouldnotwork'
