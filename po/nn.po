msgstr "Autentisering er påkravd for å setje systemtida."

#: src/timedate/org.freedesktop.timedate1.policy:33
msgid "Set system timezone"
msgstr "Set tidssona for systemet"

#: src/timedate/org.freedesktop.timedate1.policy:34
msgid "Authentication is required to set the system timezone."
msgstr "Autentisering er påkravd for å setje tidssona for systemet."

#: src/timedate/org.freedesktop.timedate1.policy:43
msgid "Set RTC to local timezone or UTC"
msgstr "Set RTC til lokal tidssone eller UTC"

#: src/timedate/org.freedesktop.timedate1.policy:44
msgid ""
"Authentication is required to control whether the RTC stores the local or "
"UTC time."
msgstr ""
"Autentisering er påkravd for å avgjere om RTC-en skal lagre lokal tid eller "
"UTC."

#: src/timedate/org.freedesktop.timedate1.policy:53
msgid "Turn network time synchronization on or off"
msgstr "Slå synkronisering av tid over nettverket på eller av"

#: src/timedate/org.freedesktop.timedate1.policy:54
msgid ""
"Authentication is required to control whether network time synchronization "
"shall be enabled."
msgstr ""
"Autentisering er påkravd for å avgjere om synkronisering av tid over "
"nettverket skal vere slått på."

#: src/core/dbus-unit.c:372
msgid "Authentication is required to start '$(unit)'."
msgstr "Autentisering er påkravd for å starte «$(unit)»."

#: src/core/dbus-unit.c:373
msgid "Authentication is required to stop '$(unit)'."
msgstr "Autentisering er påkravd for å stoppe «$(unit)»."

#: src/core/dbus-unit.c:374
msgid "Authentication is required to reload '$(unit)'."
msgstr "Autentisering er påkravd for å laste inn «$(unit)» på nytt."

#: src/core/dbus-unit.c:375 src/core/dbus-unit.c:376
msgid "Authentication is required to restart '$(unit)'."
msgstr "Autentisering er påkravd for å starte «$(unit)» på nytt."

#: src/core/dbus-unit.c:594
msgid ""
"Authentication is required to send a UNIX signal to the processes of '$"
"(unit)'."
msgstr ""
"Autentisering er påkravd for å sende eit UNIX-signal til prosessane til «$"
"(unit)»."

#: src/core/dbus-unit.c:647
msgid ""
"Authentication is required to send a UNIX signal to the processes of "
"subgroup of '$(unit)'."
msgstr ""
"Autentisering er påkravd for å sende eit UNIX-signal til prosessane i ei "
"undergruppe av «$(unit)»."

#: src/core/dbus-unit.c:675
msgid "Authentication is required to reset the \"failed\" state of '$(unit)'."
msgstr ""
"Autentisering er påkravd for å nullstille tilstanden «failed» for «$(unit)»."

#: src/core/dbus-unit.c:705
msgid "Authentication is required to set properties on '$(unit)'."
msgstr "Autentisering er påkravd for å setje eigenskapar på «$(unit)»."

#: src/core/dbus-unit.c:802
msgid ""
"Authentication is required to delete files and directories associated with '$"
"(unit)'."
msgstr ""
"Autentisering er påkravd for å slette filer og mapper som høyrer til «$(unit)"
"»."

#: src/core/dbus-unit.c:839
msgid ""
"Authentication is required to freeze or thaw the processes of '$(unit)' unit."
msgstr ""
"Autentisering er påkravd for å fryse eller tine prosessane til eininga «$"
"(unit)»."

#: src/shared/libfido2-util.c:494 src/shared/libfido2-util.c:551
msgid "Please confirm presence on security token to unlock."
msgstr "Stadfest at du er til stades, på sikkerheitstokenet for å låse opp."

#: src/shared/libfido2-util.c:510
msgid "Please verify user on security token to unlock."
msgstr "Verifiser brukaren på sikkerheitstokenet for å låse opp."

#: src/shared/libfido2-util.c:944
#, c-format
msgid ""
"Please enter security token PIN (remaining attempts before lock-out: %d):"
msgstr ""
"Skriv inn PIN-koden for sikkerheitstokenet (forsøk att før utestenging: %d):"

#: src/shared/libfido2-util.c:955
msgid "Please enter security token PIN:"
msgstr "Skriv inn PIN-koden for sikkerheitstokenet:"
