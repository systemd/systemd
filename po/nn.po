#: src/core/org.freedesktop.systemd1.policy.in:22
msgid "Send passphrase back to system"
msgstr "Send passfrasen tilbake til systemet"

#: src/core/org.freedesktop.systemd1.policy.in:23
msgid ""
"Authentication is required to send the entered passphrase back to the system."
msgstr ""
"Autentisering er påkravd for å sende den oppgjevne passfrasen tilbake til "
"systemet."

#: src/core/org.freedesktop.systemd1.policy.in:33
msgid "Manage system services or other units"
msgstr "Handsam systemtenester eller andre einingar"

#: src/core/org.freedesktop.systemd1.policy.in:34
msgid "Authentication is required to manage system services or other units."
msgstr ""
"Autentisering er påkravd for å handsame systemtenester eller andre einingar."

#: src/core/org.freedesktop.systemd1.policy.in:43
msgid "Manage system service or unit files"
msgstr "Handsam filer for systemtenester eller einingar"

#: src/core/org.freedesktop.systemd1.policy.in:44
msgid "Authentication is required to manage system service or unit files."
msgstr ""
"Autentisering er påkravd for å handsame filer for systemtenester eller "
"einingar."

#: src/core/org.freedesktop.systemd1.policy.in:54
msgid "Set or unset system and service manager environment variables"
msgstr "Set eller fjern miljøvariablar for system- og tenestehandsamaren"

#: src/core/org.freedesktop.systemd1.policy.in:55
msgid ""
"Authentication is required to set or unset system and service manager "
"environment variables."
msgstr ""
"Autentisering er påkravd for å setje eller fjerne miljøvariablar for system- "
"og tenestehandsamaren."

#: src/core/org.freedesktop.systemd1.policy.in:64
msgid "Reload the systemd state"
msgstr "Last inn systemd-tilstanden på nytt"

#: src/core/org.freedesktop.systemd1.policy.in:65
msgid "Authentication is required to reload the systemd state."
msgstr "Autentisering er påkravd for å laste inn systemd-tilstanden på nytt."

#: src/core/org.freedesktop.systemd1.policy.in:74
msgid "Dump the systemd state without rate limits"
msgstr "Skriv ut systemd-tilstanden utan fartsgrenser"

#: src/core/org.freedesktop.systemd1.policy.in:75
msgid ""
"Authentication is required to dump the systemd state without rate limits."
msgstr ""
"Autentisering er påkravd for å skrive ut systemd-tilstanden utan "
"fartsgrenser."

#: src/home/org.freedesktop.home1.policy:13
msgid "Create a home area"
msgstr "Lag eit heimeområde"

#: src/home/org.freedesktop.home1.policy:14
msgid "Authentication is required to create a user's home area."
msgstr "Autentisering er påkravd for å lage eit heimeområde for ein brukar."

#: src/home/org.freedesktop.home1.policy:23
msgid "Remove a home area"
msgstr "Fjern eit heimeområde"

#: src/home/org.freedesktop.home1.policy:24
msgid "Authentication is required to remove a user's home area."
msgstr "Autentisering er påkravd for å fjerne heimeområdet til ein brukar."

#: src/home/org.freedesktop.home1.policy:33
msgid "Check credentials of a home area"
msgstr "Kontroller innloggingsinformasjonen for eit heimeområde"

#: src/home/org.freedesktop.home1.policy:34
msgid ""
"Authentication is required to check credentials against a user's home area."
msgstr ""
"Autentisering er påkravd for å kontrollere innloggingsinformasjon mot "
"heimeområdet til ein brukar."

#: src/home/org.freedesktop.home1.policy:43
msgid "Update a home area"
msgstr "Oppdater eit heimeområde"

#: src/home/org.freedesktop.home1.policy:44
msgid "Authentication is required to update a user's home area."
msgstr "Autentisering er påkravd for å oppdatere heimeområdet til ein brukar."

#: src/home/org.freedesktop.home1.policy:53
msgid "Update your home area"
msgstr "Oppdater heimeområdet ditt"

#: src/home/org.freedesktop.home1.policy:54
msgid "Authentication is required to update your home area."
msgstr "Autentisering er påkravd for å oppdatere heimeområdet ditt."

#: src/home/org.freedesktop.home1.policy:63
msgid "Resize a home area"
msgstr "Endre storleiken på eit heimeområde"

#: src/home/org.freedesktop.home1.policy:64
msgid "Authentication is required to resize a user's home area."
msgstr ""
"Autentisering er påkravd for å endre storleiken på heimeområdet til ein "
"brukar."

#: src/home/org.freedesktop.home1.policy:73
msgid "Change password of a home area"
msgstr "Endre passordet til eit heimeområde"

#: src/home/org.freedesktop.home1.policy:74
msgid ""
"Authentication is required to change the password of a user's home area."
msgstr ""
"Autentisering er påkravd for å endre passordet til heimeområdet til ein "
"brukar."

#: src/home/org.freedesktop.home1.policy:83
msgid "Activate a home area"
msgstr "Aktiver eit heimeområde"

#: src/home/org.freedesktop.home1.policy:84
msgid "Authentication is required to activate a user's home area."
msgstr "Autentisering er påkravd for å aktivere heimeområdet til ein brukar."

#: src/home/org.freedesktop.home1.policy:93
msgid "Manage Home Directory Signing Keys"
msgstr "Handsam signeringsnøklar for heimemapper"

#: src/home/org.freedesktop.home1.policy:94
msgid "Authentication is required to manage signing keys for home directories."
msgstr ""
"Autentisering er påkravd for å handsame signeringsnøklar for heimemapper."

#: src/home/pam_systemd_home.c:328
#, c-format
msgid ""
"Home of user %s is currently absent, please plug in the necessary storage "
"device or backing file system."
msgstr ""
"Heimeområdet til brukaren %s er ikkje tilgjengeleg no. Kople til "
"lagringseininga eller filsystemet det ligg på."

#: src/home/pam_systemd_home.c:333
#, c-format
msgid "Too frequent login attempts for user %s, try again later."
msgstr "For mange innloggingsforsøk for brukaren %s, prøv på nytt seinare."

#: src/home/pam_systemd_home.c:345
msgid "Password: "
msgstr "Passord: "

#: src/home/pam_systemd_home.c:347
#, c-format
msgid "Password incorrect or not sufficient for authentication of user %s."
msgstr "Passordet er feil eller ikkje nok til å autentisere brukaren %s."

#: src/home/pam_systemd_home.c:348
msgid "Sorry, try again: "
msgstr "Prøv på nytt: "

#: src/home/pam_systemd_home.c:370
msgid "Recovery key: "
msgstr "Gjenopprettingsnøkkel: "

#: src/home/pam_systemd_home.c:372
#, c-format
msgid ""
"Password/recovery key incorrect or not sufficient for authentication of user "
"%s."
msgstr ""
"Passordet eller gjenopprettingsnøkkelen er feil eller ikkje nok til å "
"autentisere brukaren %s."

#: src/home/pam_systemd_home.c:373
msgid "Sorry, reenter recovery key: "
msgstr "Skriv inn gjenopprettingsnøkkelen på nytt: "

#: src/home/pam_systemd_home.c:393
#, c-format
msgid "Security token of user %s not inserted."
msgstr "Sikkerheitstokenet til brukaren %s er ikkje sett inn."

#: src/home/pam_systemd_home.c:394 src/home/pam_systemd_home.c:397
msgid "Try again with password: "
msgstr "Prøv på nytt med passord: "

#: src/home/pam_systemd_home.c:396
#, c-format
msgid ""
"Password incorrect or not sufficient, and configured security token of user "
"%s not inserted."
msgstr ""
"Passordet er feil eller ikkje nok, og sikkerheitstokenet som er sett opp for "
"brukaren %s, er ikkje sett inn."

#: src/home/pam_systemd_home.c:416
msgid "Security token PIN: "
msgstr "PIN-kode for sikkerheitstoken: "

#: src/home/pam_systemd_home.c:433
#, c-format
msgid "Please authenticate physically on security token of user %s."
msgstr "Autentiser deg fysisk på sikkerheitstokenet til brukaren %s."

#: src/home/pam_systemd_home.c:444
#, c-format
msgid "Please confirm presence on security token of user %s."
msgstr "Stadfest at du er til stades, på sikkerheitstokenet til brukaren %s."

#: src/home/pam_systemd_home.c:455
#, c-format
msgid "Please verify user on security token of user %s."
msgstr "Verifiser brukaren på sikkerheitstokenet til brukaren %s."

#: src/home/pam_systemd_home.c:464
msgid ""
"Security token PIN is locked, please unlock it first. (Hint: Removal and re-"
"insertion might suffice.)"
msgstr ""
"PIN-koden for sikkerheitstokenet er låst. Lås han opp først. (Tips: Det kan "
"vere nok å ta tokenet ut og setje det inn att.)"

#: src/home/pam_systemd_home.c:472
#, c-format
msgid "Security token PIN incorrect for user %s."
msgstr "Feil PIN-kode for sikkerheitstokenet til brukaren %s."

#: src/home/pam_systemd_home.c:473 src/home/pam_systemd_home.c:492
#: src/home/pam_systemd_home.c:511
msgid "Sorry, retry security token PIN: "
msgstr "Prøv PIN-koden for sikkerheitstokenet på nytt: "

#: src/home/pam_systemd_home.c:491
#, c-format
msgid "Security token PIN of user %s incorrect (only a few tries left!)"
msgstr ""
"Feil PIN-kode for sikkerheitstokenet til brukaren %s (berre nokre få forsøk "
"att!)"

#: src/home/pam_systemd_home.c:510
#, c-format
msgid "Security token PIN of user %s incorrect (only one try left!)"
msgstr ""
"Feil PIN-kode for sikkerheitstokenet til brukaren %s (berre eitt forsøk att!)"

#: src/home/pam_systemd_home.c:677
#, c-format
msgid "Home of user %s is currently not active, please log in locally first."
msgstr "Heimeområdet til brukaren %s er ikkje aktivt no. Logg inn lokalt først."

#: src/home/pam_systemd_home.c:679
#, c-format
msgid "Home of user %s is currently locked, please unlock locally first."
msgstr "Heimeområdet til brukaren %s er låst no. Lås det opp lokalt først."

#: src/home/pam_systemd_home.c:713
#, c-format
msgid "Too many unsuccessful login attempts for user %s, refusing."
msgstr "For mange mislukka innloggingsforsøk for brukaren %s, nektar."

#: src/home/pam_systemd_home.c:1015
msgid "User record is blocked, prohibiting access."
msgstr "Brukaroppføringa er blokkert, tilgang vert nekta."

#: src/home/pam_systemd_home.c:1019
msgid "User record is not valid yet, prohibiting access."
msgstr "Brukaroppføringa er ikkje gyldig enno, tilgang vert nekta."

#: src/home/pam_systemd_home.c:1023
msgid "User record is not valid anymore, prohibiting access."
msgstr "Brukaroppføringa er ikkje gyldig lenger, tilgang vert nekta."

#: src/home/pam_systemd_home.c:1028 src/home/pam_systemd_home.c:1077
msgid "User record not valid, prohibiting access."
msgstr "Brukaroppføringa er ikkje gyldig, tilgang vert nekta."

#: src/home/pam_systemd_home.c:1038
#, c-format
msgid "Too many logins, try again in %s."
msgstr "For mange innloggingar, prøv på nytt om %s."

#: src/home/pam_systemd_home.c:1049
msgid "Password change required."
msgstr "Passordet må endrast."

#: src/home/pam_systemd_home.c:1053
msgid "Password expired, change required."
msgstr "Passordet har gått ut og må endrast."

#: src/home/pam_systemd_home.c:1059
msgid "Password is expired, but can't change, refusing login."
msgstr "Passordet har gått ut, men kan ikkje endrast. Nektar innlogging."

#: src/home/pam_systemd_home.c:1063
msgid "Password will expire soon, please change."
msgstr "Passordet går snart ut. Endre det."

#: src/hostname/org.freedesktop.hostname1.policy:20
msgid "Set hostname"
msgstr "Set vertsnamn"

#: src/hostname/org.freedesktop.hostname1.policy:21
msgid "Authentication is required to set the local hostname."
msgstr "Autentisering er påkravd for å setje det lokale vertsnamnet."

#: src/hostname/org.freedesktop.hostname1.policy:30
msgid "Set static hostname"
msgstr "Set statisk vertsnamn"

#: src/hostname/org.freedesktop.hostname1.policy:31
msgid ""
"Authentication is required to set the statically configured local hostname, "
"as well as the pretty hostname."
msgstr ""
"Autentisering er påkravd for å setje det statisk oppsette lokale vertsnamnet "
"og det pene vertsnamnet."

#: src/hostname/org.freedesktop.hostname1.policy:41
msgid "Set machine information"
msgstr "Set maskininformasjon"

#: src/hostname/org.freedesktop.hostname1.policy:42
msgid "Authentication is required to set local machine information."
msgstr "Autentisering er påkravd for å setje informasjon om den lokale maskina."

#: src/hostname/org.freedesktop.hostname1.policy:51
msgid "Get product UUID"
msgstr "Hent produkt-UUID"

#: src/hostname/org.freedesktop.hostname1.policy:52
msgid "Authentication is required to get product UUID."
msgstr "Autentisering er påkravd for å hente produkt-UUID-en."

#: src/hostname/org.freedesktop.hostname1.policy:61
msgid "Get hardware serial number"
msgstr "Hent serienummeret til maskinvara"

#: src/hostname/org.freedesktop.hostname1.policy:62
msgid "Authentication is required to get hardware serial number."
msgstr "Autentisering er påkravd for å hente serienummeret til maskinvara."

#: src/hostname/org.freedesktop.hostname1.policy:71
msgid "Get system description"
msgstr "Hent systemskildringa"

#: src/hostname/org.freedesktop.hostname1.policy:72
msgid "Authentication is required to get system description."
msgstr "Autentisering er påkravd for å hente systemskildringa."

#: src/import/org.freedesktop.import1.policy:22
msgid "Import a disk image"
msgstr "Importer eit diskbilete"

#: src/import/org.freedesktop.import1.policy:23
msgid "Authentication is required to import an image."
msgstr "Autentisering er påkravd for å importere eit bilete."

#: src/import/org.freedesktop.import1.policy:32
msgid "Export a disk image"
msgstr "Eksporter eit diskbilete"

#: src/import/org.freedesktop.import1.policy:33
msgid "Authentication is required to export disk image."
msgstr "Autentisering er påkravd for å eksportere eit diskbilete."

#: src/import/org.freedesktop.import1.policy:42
msgid "Download a disk image"
msgstr "Last ned eit diskbilete"

#: src/import/org.freedesktop.import1.policy:43
msgid "Authentication is required to download a disk image."
msgstr "Autentisering er påkravd for å laste ned eit diskbilete."

#: src/import/org.freedesktop.import1.policy:52
msgid "Cancel transfer of a disk image"
msgstr "Avbryt overføringa av eit diskbilete"

#: src/import/org.freedesktop.import1.policy:53
msgid ""
"Authentication is required to cancel the ongoing transfer of a disk image."
msgstr "Autentisering er påkravd for å avbryte overføringa av eit diskbilete."

#: src/locale/org.freedesktop.locale1.policy:22
msgid "Set system locale"
msgstr "Set språkinnstillingane for systemet"

#: src/locale/org.freedesktop.locale1.policy:23
msgid "Authentication is required to set the system locale."
msgstr "Autentisering er påkravd for å setje språkinnstillingane for systemet."

#: src/locale/org.freedesktop.locale1.policy:33
msgid "Set system keyboard settings"
msgstr "Set tastaturinnstillingane for systemet"

#: src/locale/org.freedesktop.locale1.policy:34
msgid "Authentication is required to set the system keyboard settings."
msgstr ""
"Autentisering er påkravd for å setje tastaturinnstillingane for systemet."

#: src/login/org.freedesktop.login1.policy:22
msgid "Allow applications to inhibit system shutdown"
msgstr "Tillat appar å hindre at systemet vert slått av"

#: src/login/org.freedesktop.login1.policy:23
msgid ""
"Authentication is required for an application to inhibit system shutdown."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne hindre at systemet vert "
"slått av."

#: src/login/org.freedesktop.login1.policy:33
msgid "Allow applications to delay system shutdown"
msgstr "Tillat appar å utsetje at systemet vert slått av"

#: src/login/org.freedesktop.login1.policy:34
msgid "Authentication is required for an application to delay system shutdown."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne utsetje at systemet "
"vert slått av."

#: src/login/org.freedesktop.login1.policy:44
msgid "Allow applications to inhibit system sleep"
msgstr "Tillat appar å hindre at systemet går i kvilemodus"

#: src/login/org.freedesktop.login1.policy:45
msgid "Authentication is required for an application to inhibit system sleep."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne hindre at systemet går "
"i kvilemodus."

#: src/login/org.freedesktop.login1.policy:55
msgid "Allow applications to delay system sleep"
msgstr "Tillat appar å utsetje at systemet går i kvilemodus"

#: src/login/org.freedesktop.login1.policy:56
msgid "Authentication is required for an application to delay system sleep."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne utsetje at systemet går "
"i kvilemodus."

#: src/login/org.freedesktop.login1.policy:65
msgid "Allow applications to inhibit automatic system suspend"
msgstr "Tillat appar å hindre automatisk kvilemodus"

#: src/login/org.freedesktop.login1.policy:66
msgid ""
"Authentication is required for an application to inhibit automatic system "
"suspend."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne hindre automatisk "
"kvilemodus."

#: src/login/org.freedesktop.login1.policy:75
msgid "Allow applications to inhibit system handling of the power key"
msgstr "Tillat appar å hindre at systemet handsamar straumknappen"

#: src/login/org.freedesktop.login1.policy:76
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the power key."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne hindre at systemet "
"handsamar straumknappen."

#: src/login/org.freedesktop.login1.policy:86
msgid "Allow applications to inhibit system handling of the suspend key"
msgstr "Tillat appar å hindre at systemet handsamar kviletasten"

#: src/login/org.freedesktop.login1.policy:87
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the suspend key."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne hindre at systemet "
"handsamar kviletasten."

#: src/login/org.freedesktop.login1.policy:97
msgid "Allow applications to inhibit system handling of the hibernate key"
msgstr "Tillat appar å hindre at systemet handsamar dvaletasten"

#: src/login/org.freedesktop.login1.policy:98
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the hibernate key."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne hindre at systemet "
"handsamar dvaletasten."

#: src/login/org.freedesktop.login1.policy:107
msgid "Allow applications to inhibit system handling of the lid switch"
msgstr "Tillat appar å hindre at systemet handsamar lokbrytaren"

#: src/login/org.freedesktop.login1.policy:108
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the lid switch."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne hindre at systemet "
"handsamar lokbrytaren."

#: src/login/org.freedesktop.login1.policy:117
msgid "Allow applications to inhibit system handling of the reboot key"
msgstr "Tillat appar å hindre at systemet handsamar omstartstasten"

#: src/login/org.freedesktop.login1.policy:118
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the reboot key."
msgstr ""
"Autentisering er påkravd for å at ein app skal kunne hindre at systemet "
"handsamar omstartstasten."

#: src/login/org.freedesktop.login1.policy:128
msgid "Allow non-logged-in user to run programs"
msgstr "Tillat ein brukar som ikkje er innlogga, å køyre program"

#: src/login/org.freedesktop.login1.policy:129
msgid "Explicit request is required to run programs as a non-logged-in user."
msgstr ""
"Det krevst ein eksplisitt førespurnad for å køyre program som ein brukar som "
"ikkje er innlogga."

#: src/login/org.freedesktop.login1.policy:138
msgid "Allow non-logged-in users to run programs"
msgstr "Tillat brukarar som ikkje er innlogga, å køyre program"

#: src/login/org.freedesktop.login1.policy:139
msgid "Authentication is required to run programs as a non-logged-in user."
msgstr ""
"Autentisering er påkravd for å køyre program som ein brukar som ikkje er "
"innlogga."

#: src/login/org.freedesktop.login1.policy:148
msgid "Allow attaching devices to seats"
msgstr "Tillat å knyte einingar til sete"

#: src/login/org.freedesktop.login1.policy:149
msgid "Authentication is required to attach a device to a seat."
msgstr "Autentisering er påkravd for å knyte ei eining til eit sete."

#: src/login/org.freedesktop.login1.policy:159
msgid "Flush device to seat attachments"
msgstr "Tilbakestill tilknytinga av einingar til sete"

#: src/login/org.freedesktop.login1.policy:160
msgid "Authentication is required to reset how devices are attached to seats."
msgstr ""
"Autentisering er påkravd for å tilbakestille korleis einingar er knytte til "
"sete."

#: src/login/org.freedesktop.login1.policy:169
msgid "Power off the system"
msgstr "Slå av systemet"

#: src/login/org.freedesktop.login1.policy:170
msgid "Authentication is required to power off the system."
msgstr "Autentisering er påkravd for å slå av systemet."

#: src/login/org.freedesktop.login1.policy:180
msgid "Power off the system while other users are logged in"
msgstr "Slå av systemet medan andre brukarar er innlogga"

#: src/login/org.freedesktop.login1.policy:181
msgid ""
"Authentication is required to power off the system while other users are "
"logged in."
msgstr ""
"Autentisering er påkravd for å slå av systemet medan andre brukarar er "
"innlogga."

#: src/login/org.freedesktop.login1.policy:191
msgid "Power off the system while an application is inhibiting this"
msgstr "Slå av systemet medan ein app hindrar det"

#: src/login/org.freedesktop.login1.policy:192
msgid ""
"Authentication is required to power off the system while an application is "
"inhibiting this."
msgstr ""
"Autentisering er påkravd for å slå av systemet medan ein app hindrar det."

#: src/login/org.freedesktop.login1.policy:202
msgid "Reboot the system"
msgstr "Start systemet på nytt"

#: src/login/org.freedesktop.login1.policy:203
msgid "Authentication is required to reboot the system."
msgstr "Autentisering er påkravd for å starte systemet på nytt."

#: src/login/org.freedesktop.login1.policy:213
msgid "Reboot the system while other users are logged in"
msgstr "Start systemet på nytt medan andre brukarar er innlogga"

#: src/login/org.freedesktop.login1.policy:214
msgid ""
"Authentication is required to reboot the system while other users are logged "
"in."
msgstr ""
"Autentisering er påkravd for å starte systemet på nytt medan andre brukarar "
"er innlogga."

#: src/login/org.freedesktop.login1.policy:224
msgid "Reboot the system while an application is inhibiting this"
msgstr "Start systemet på nytt medan ein app hindrar det"

#: src/login/org.freedesktop.login1.policy:225
msgid ""
"Authentication is required to reboot the system while an application is "
"inhibiting this."
msgstr ""
"Autentisering er påkravd for å starte systemet på nytt medan ein app hindrar "
"det."

#: src/login/org.freedesktop.login1.policy:235
msgid "Halt the system"
msgstr "Stopp systemet"

#: src/login/org.freedesktop.login1.policy:236
msgid "Authentication is required to halt the system."
