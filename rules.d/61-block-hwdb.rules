# do not edit this file, it will be overwritten on update

ACTION=="remove", GOTO="block_hwdb_end"
SUBSYSTEM!="block", GOTO="block_hwdb_end"
ENV{DEVTYPE}!="disk", GOTO="block_hwdb_end"

# 60-persistent-storage.rules sets ID_MODEL and ID_REVISION, so this file must
# sort after it. 90-iocost.rules builds the same lookup key.
ENV{.MODEL}=""
ENV{ID_MODEL}!="", ENV{.MODEL}="$env{ID_MODEL}"
ENV{ID_MODEL_FROM_DATABASE}!="", ENV{.MODEL}="$env{ID_MODEL_FROM_DATABASE}"
ENV{.MODEL}=="", GOTO="block_hwdb_end"

IMPORT{builtin}="hwdb 'block::name:$env{.MODEL}:fwrev:$env{ID_REVISION}:'"

ENV{ID_BLOCK_IO_TIMEOUT_MS}=="?*", TEST=="queue/io_timeout", \
  ATTR{queue/io_timeout}="$env{ID_BLOCK_IO_TIMEOUT_MS}"

LABEL="block_hwdb_end"
