# do not edit this file, it will be overwritten on update

ACTION=="remove", GOTO="block_hwdb_end"
SUBSYSTEM!="block", GOTO="block_hwdb_end"
ENV{DEVTYPE}!="disk", GOTO="block_hwdb_end"

# 60-persistent-storage.rules sets ID_MODEL and ID_REVISION, so this file must
# sort after it. 90-iocost.rules uses the IOCOST_SOLUTIONS property that this
# file imports from the hwdb.
ENV{.MODEL}=""
ENV{ID_MODEL}!="", ENV{.MODEL}="$env{ID_MODEL}"
ENV{ID_MODEL_FROM_DATABASE}!="", ENV{.MODEL}="$env{ID_MODEL_FROM_DATABASE}"
ENV{.MODEL}=="", GOTO="block_hwdb_end"

IMPORT{builtin}="hwdb 'block::name:$env{.MODEL}:fwrev:$env{ID_REVISION}:'"

# The kernel parses queue/io_timeout as an unsigned 32-bit integer.
ENV{.IO_TIMEOUT}="$env{ID_BLOCK_IO_TIMEOUT_MS}"
ENV{.IO_TIMEOUT}=="max", ENV{.IO_TIMEOUT}="4294967295"

# 60-block.rules sets the "watch" option for disks, so udev generates a change
# event whenever a program closes a disk after writing to it. We only write
# queue/io_timeout on add events, so that a change event doesn't overwrite a
# value that was set at runtime.
ACTION=="add", ENV{.IO_TIMEOUT}=="?*", TEST=="queue/io_timeout", \
  ATTR{queue/io_timeout}="$env{.IO_TIMEOUT}"

LABEL="block_hwdb_end"
