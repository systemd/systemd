# do not edit this file, it will be overwritten on update

ACTION=="remove", GOTO="persistent_usb_end"
SUBSYSTEM!="usb", GOTO="persistent_usb_end"
ENV{DEVTYPE}!="usb_device", GOTO="persistent_usb_end"
ENV{ID_LINK_DIR}!="?*", GOTO="persistent_usb_end"

IMPORT{builtin}="path_id"
ENV{ID_SERIAL}=="?*", SYMLINK+="$env{ID_LINK_DIR}/by-id/$env{ID_BUS}-$env{ID_SERIAL}"
ENV{ID_PATH_WITH_USB_REVISION}=="?*", SYMLINK+="$env{ID_LINK_DIR}/by-path/$env{ID_PATH_WITH_USB_REVISION}"
ENV{ID_PATH_WITH_USB_REVISION}=="", ENV{ID_PATH}=="?*", SYMLINK+="$env{ID_LINK_DIR}/by-path/$env{ID_PATH}"

LABEL="persistent_usb_end"
