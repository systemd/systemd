# @generated by `tine`; configure this project in tine.toml instead.

[cells]
prelude = prelude
none = none
root = .
tine = tine
settings = tine-settings
catalog = tine/catalog

[cell_aliases]
config = prelude
toolchains = tine
fbsource = none

[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:root//...->tine//platform:default target:tine//...->tine//platform:default target:catalog//...->tine//platform:default

[build]
execution_platforms = tine//platform:default

[project]
ignore = **/.git, **/.jj, **/.hg, **/.svn

[buck2]
materializations = deferred
sqlite_materializer_state = true
sqlite_dep_file_state = true
defer_write_actions = true

[buck2_resource_control]
status = if_available
enable_suspension = true
preferred_action_suspend_strategy = cgroup_freeze
