[Unit]
Description=Varlink SFTP Server (root, read-only)
Documentation=man:varlinkctl(1)
Requires=varlink-sftp-root-ro.socket
ConditionPathExists={{SFTP_SERVER}}

[Service]
Type=notify
# -R places sftp-server in read-only mode
# -e makes it log to stderr (which ends up in the journal)
ExecStart=varlinkctl serve --polkit-action=io.systemd.sftp.root-read-only io.systemd.Sftp.RootReadOnly.Connect -- {{SFTP_SERVER}} -e -R

# Avoid settings that hide parts of the file system (PrivateDevices=,
# ProtectProc=, ...) so both flavours export the same view.
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
TasksMax=64
# While -R already denies writes we still enforce it (because we can).
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
