[Unit]
Description=Core Dump Kernel Socket
Documentation=man:systemd-coredump(8)
DefaultDependencies=no
Before=sockets.target
Before=shutdown.target
Conflicts=shutdown.target

#FIXME: Replace this condition with ExecCondition=, which is currently not supported by socket units.
ConditionVersion=kernel >= 6.19

[Socket]
ExecStartPre={{LIBEXECDIR}}/systemd-coredump --check-pidfd-features
ExecStartPost={{LIBEXECDIR}}/systemd-sysctl --strict --verify --install=60-coredump --inline "kernel.core_pattern=@@/run/systemd/coredump-kernel"
ExecStopPre={{LIBEXECDIR}}/systemd-sysctl --revert=60-coredump --prefix=/kernel/core_pattern
ListenStream=/run/systemd/coredump-kernel
FileDescriptorName=coredump-kernel-socket
SocketMode=0600
Accept=yes
MaxConnections=16
