[Unit]
Description=Varlink SFTP Server Socket (read-only) EQUIVALENT TO ROOT ACCESS
Documentation=man:varlinkctl(1)
ConditionPathExists={{SFTP_SERVER}}

[Socket]
ListenStream=/run/systemd/io.systemd.Sftp.RootReadOnly
Symlinks=/run/varlink/registry/io.systemd.Sftp.RootReadOnly
SocketMode=0666
XAttrEntryPoint=user.varlink=entrypoint
XAttrListen=user.varlink=listen

[Install]
WantedBy=sockets.target
