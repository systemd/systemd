[Unit]
Description=Varlink SFTP Server (read-write) EQUIVALENT TO ROOT ACCESS
Documentation=man:varlinkctl(1)
Requires=varlink-sftp-root-rw.socket

[Service]
Type=notify
# -e makes it log to stderr (which ends up in the journal)
ExecStart=varlinkctl serve io.systemd.Sftp.RootReadWrite.Connect -- {{SFTP_SERVER}} -e
