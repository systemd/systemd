[Unit]
Description=Varlink SFTP Server EQUIVALENT TO ROOT ACCESS
Documentation=man:varlinkctl(1)
Requires=varlink-sftp-root.socket
ConditionPathExists={{SFTP_SERVER}}

[Service]
Type=notify
# -e makes it log to stderr (which ends up in the journal)
ExecStart=varlinkctl serve io.systemd.Sftp.Root.Connect -- {{SFTP_SERVER}} -e

NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
TasksMax=64
