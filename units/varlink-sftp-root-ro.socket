[Unit]
Description=Varlink SFTP Server Socket (read-only) EQUIVALENT TO ROOT ACCESS
Documentation=man:varlinkctl(1)
After=systemd-sysusers.service

[Socket]
ListenStream=/run/varlink/registry/io.systemd.Sftp.RootReadOnly
SocketGroup=systemd-sftp-root-ro
SocketMode=0660

[Install]
WantedBy=sockets.target
