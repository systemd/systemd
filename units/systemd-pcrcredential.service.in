[Unit]
Description=TPM NvPCR Interactive Credential Measurement
Documentation=man:systemd-pcrcredential.service(8)
DefaultDependencies=no
Conflicts=shutdown.target initrd-switch-root.target
After=tpm2.target systemd-pcrnvdone.service
Before=sysinit.target cryptsetup-pre.target cryptsetup.target shutdown.target initrd-switch-root.target
ConditionSecurity=measured-os
ConditionPathExists=/etc/initrd-release
ConditionPathExists=/run/systemd/nvpcr/interactive-credentials.auth
FailureAction=reboot-force

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{LIBEXECDIR}}/systemd-pcrextend --graceful --interactive-credentials
