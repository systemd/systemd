[Unit]
Description=Time-Stamp Acquisition Service Socket
Documentation=man:systemd-timestampd.service(8)
DefaultDependencies=no
Conflicts=shutdown.target
Before=sockets.target shutdown.target

[Socket]
ListenStream=/run/systemd/io.systemd.Timestamp
Symlinks=/run/varlink/registry/io.systemd.Timestamp
FileDescriptorName=varlink
SocketMode=0666
XAttrEntryPoint=user.varlink=entrypoint
XAttrListen=user.varlink=listen

[Install]
WantedBy=sockets.target
