[Unit]
Description=PTY Broker
Documentation=man:systemd-ptybrokerd.service(8)
Requires=systemd-ptybrokerd.socket
After=systemd-ptybrokerd.socket
Conflicts=shutdown.target
Before=default.target shutdown.target
DefaultDependencies=no

[Service]
ExecStart={{LIBEXECDIR}}/systemd-ptybrokerd --user
KillMode=mixed
LimitNOFILE={{HIGH_RLIMIT_NOFILE}}
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=0
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
Type=notify
{{SERVICE_WATCHDOG}}

[Install]
Also=systemd-ptybrokerd.socket
