[Unit]
Description=Kernel Core Pattern Register
Documentation=man:systemd-coredump(8)
DefaultDependencies=no
After=systemd-coredumpd.service
BindsTo=systemd-coredumpd.service
Before=sysinit.target systemd-sysctl.service shutdown.target
Conflicts=shutdown.target
ConditionVirtualization=!container
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
ExecCondition={{LIBEXECDIR}}/systemd-coredump --check-requirements
ExecStart={{LIBEXECDIR}}/systemd-sysctl --strict --verify --save=60-coredump --inline "kernel.core_pattern=@@/run/systemd/coredump-kernel"
ExecStop={{LIBEXECDIR}}/systemd-sysctl --revert=60-coredump --prefix=/kernel/core_pattern
RemainAfterExit=yes
